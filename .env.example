# SPEC §1.2. 실제 값은 .env.local 에 넣는다 (.gitignore 됨).
# NEXT_PUBLIC_ 이 붙은 것만 브라우저로 나간다. 나머지는 서버 라우트 전용이다.

# NAVER Web Dynamic Map Client ID — NCP 콘솔에서 발급.
# 서비스 URL 에 http://localhost:3000 과 배포 도메인을 둘 다 등록해야 한다.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# GPS 를 못 쓸 때 기준이 되는 사무실 좌표
NEXT_PUBLIC_FALLBACK_LAT=37.5665
NEXT_PUBLIC_FALLBACK_LNG=126.9780

# Supabase (0.4~)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 네이버 지역검색 (5.1) — 서버 전용
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
